		mk("UIGridLayout", {CellSize = UDim2.new(0.5, -4, 0, 46), CellPadding = UDim2.fromOffset(8, 4), SortOrder = Enum.SortOrder.LayoutOrder}, grid)
		for i, code in ipairs(list) do
			local it = ITEMS[code] or {name = "?", desc = ""}
			local b = mk("TextButton", {BackgroundColor3 = myTurn and C.purple or C.disabled, AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i, RichText = true, TextWrapped = true,
				Text = ("<b>%s</b>\n<font size='11' color='#c8c8d8'>%s</font>"):format(it.name, it.desc), Font = Enum.Font.Gotham, TextSize = 13,
				TextColor3 = myTurn and Color3.new(1, 1, 1) or C.muted}, grid)
			corner(b, 7)
			mk("UIGradient", {Rotation = 90, Color = ColorSequence.new({ColorSequenceKeypoint.new(0, myTurn and C.purple or C.disabled), ColorSequenceKeypoint.new(1, C.bg)})}, b)
			mk("UIStroke", {Color = myTurn and Color3.fromRGB(185, 155, 255) or C.panel2, Transparency = .35, Thickness = 1}, b)

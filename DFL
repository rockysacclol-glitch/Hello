local function tremble(dur, mag)
	local g = gun.model
	if not g then return end
	task.spawn(function()
		local t0 = os.clock()
		while alive and gun.model == g and os.clock() - t0 < dur do
			local k = (os.clock() - t0) / dur
			local m = mag * (0.4 + k) * 0.02
			if gun.weld and gun.weld.Parent then
				gun.weld.C0 = gun.cur * CFrame.Angles(rand(-m, m), rand(-m, m), rand(-m, m))
			end
			task.wait(0.03)
		end
		if gun.model == g and gun.weld and gun.weld.Parent then gun.weld.C0 = gun.cur end
	end)
end

local function cockHammer()
	if not gun.model then return end
	snd("click", 0.8, 1.3)
	tweenC0(gun.hammerWeld, 0.14, gun.hammerCock(gun.hammerBase), Enum.EasingStyle.Quad)
	tweenC0(gun.triggerWeld, 0.14, gun.triggerBase * CFrame.new(0, 0, 0.03), Enum.EasingStyle.Quad)
end

local function fireFx()
	if not gun.model then return end
	local sm, sp, fl = gun.muzzle:FindFirstChild("Smoke"), gun.muzzle:FindFirstChild("Sparks"), gun.muzzle:FindFirstChild("Flash")
	if sm then sm:Emit(14) end
	if sp then sp:Emit(10) end
	if fl then fl.Enabled = true task.delay(0.08, function() if fl.Parent then fl.Enabled = false end end) end
	if gun.flash then
		gun.flash.Transparency = 0.15
		TS:Create(gun.flash, TweenInfo.new(0.12), {Transparency = 1}):Play()
	end
	tweenC0(gun.hammerWeld, 0.05, gun.hammerBase, Enum.EasingStyle.Quad)
	tweenC0(gun.triggerWeld, 0.08, gun.triggerBase)
	gun.cylAngle = (gun.cylAngle or 0) + math.pi / 3
	tweenC0(gun.cylWeld, 0.12, gun.cylSpin(gun.cylBase, gun.cylAngle), Enum.EasingStyle.Quad)
	if gun.weld and gun.cur then
		local base = gun.cur
		tweenC0(gun.weld, 0.06, base * CFrame.new(0, 0.04, 0.16) * CFrame.Angles(math.rad(16), 0, 0), Enum.EasingStyle.Quad)
		task.delay(0.08, function()
			if gun.weld and gun.weld.Parent then tweenC0(gun.weld, 0.35, base, Enum.EasingStyle.Back) end
		end)
	end
	if gun.arm then
		local a = gun.arm
		local d, e = a.deg, a.elb
		armPose(a, d + 11, e + 6, 0.06, Enum.EasingStyle.Quad)
		task.delay(0.09, function() if gun.arm == a then armPose(a, d, e, 0.35, Enum.EasingStyle.Back) end end)
	end
end

local function spinGunFx()
	if not gun.model or not gun.cylWeld then return end
	local w, base, spinFn = gun.cylWeld, gun.cylBase, gun.cylSpin
	local nv = mk("NumberValue", {Value = gun.cylAngle or 0})
	local c
	c = nv.Changed:Connect(function(v) if w.Parent then w.C0 = spinFn(base, v) end end)
	local tw = TS:Create(nv, TweenInfo.new(T.spin, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Value = (gun.cylAngle or 0) + math.pi * 12})
	tw.Completed:Connect(function() c:Disconnect() nv:Destroy() end)
	tw:Play()
	gun.cylAngle = 0
	local n = 16
	for i = 1, n do
		task.delay(T.spin * math.sqrt(i / n) * 0.92, function() snd("click", 0.35, 1.5 + (i / n) * 0.3) end)
	end
	if gun.weld and gun.cur then
		local base0 = gun.cur
		local g = gun.model
		tweenC0(gun.weld, 0.25, base0 * CFrame.Angles(math.rad(22), 0, math.rad(-6)), Enum.EasingStyle.Back)
		task.delay(T.spin * 0.8, function()
			if gun.model == g and gun.weld and gun.weld.Parent then tweenC0(gun.weld, 0.4, base0, Enum.EasingStyle.Quint) end
		end)
	end
end

local function buildItem(code, parent)
	local model = mk("Model", {Name = "RRItem_" .. tostring(code)}, parent)
	local function part(n, size, color, mat, cf, shape, trans)
		local p = mk("Part", {Name = n, Size = size, Color = color, Material = mat or Enum.Material.SmoothPlastic, Transparency = trans or 0,
			CanCollide = false, CanTouch = false, CanQuery = false, Massless = true, CastShadow = false, CFrame = cf,
			TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, model)
		if shape then p.Shape = shape end
		return p
	end
	local root = part("Grip", Vector3.new(.1, .1, .1), Color3.new(1, 1, 1), nil, CFrame.new(), nil, 1)
	local function add(n, size, color, mat, cf, shape, trans)
		local p = part(n, size, color, mat, cf, shape, trans)
		mk("Weld", {Part0 = root, Part1 = p, C0 = cf}, p)
		return p
	end
	local CYL = Enum.PartType.Cylinder
	local up = CFrame.Angles(0, 0, math.rad(90))
	local face = CFrame.Angles(0, math.rad(90), 0)
	local function ring(prefix, centerCF, radius, n, thick, depth, color, mat)
		local len = (2 * math.pi * radius / n) * 1.15
		for i = 1, n do
			local a = (i - 1) / n * math.pi * 2
			add(prefix .. i, Vector3.new(thick, len, depth), color, mat or Enum.Material.Metal,
				centerCF * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0) * CFrame.Angles(0, 0, a))
		end
	end
	if code == "m" then
		add("Handle", Vector3.new(.07, .5, .07), CONFIG.gun.grip, Enum.Material.Wood, CFrame.new(0, .12, 0))
		add("Collar", Vector3.new(.09, .06, .09), Color3.fromRGB(80, 86, 98), Enum.Material.Metal, CFrame.new(0, .4, 0))
		ring("Rim", CFrame.new(0, .67, 0), .27, 12, .06, .07, Color3.fromRGB(80, 86, 98))
		add("Lens", Vector3.new(.03, .5, .5), Color3.fromRGB(125, 215, 245), Enum.Material.Glass, CFrame.new(0, .67, 0) * face, CYL, .45)
	elseif code == "b" then
		add("Body", Vector3.new(.5, .2, .2), Color3.fromRGB(122, 66, 22), Enum.Material.SmoothPlastic, up, CYL, .08)
		add("Shoulder", Vector3.new(.1, .2, .2), Color3.fromRGB(122, 66, 22), Enum.Material.SmoothPlastic, CFrame.new(0, .28, 0) * up, CYL, .08)
		add("Neck", Vector3.new(.24, .09, .09), Color3.fromRGB(130, 72, 26), Enum.Material.SmoothPlastic, CFrame.new(0, .42, 0) * up, CYL, .08)
		add("Cap", Vector3.new(.03, .11, .11), Color3.fromRGB(200, 190, 140), Enum.Material.Metal, CFrame.new(0, .555, 0) * up, CYL)
		add("Label", Vector3.new(.2, .207, .207), Color3.fromRGB(228, 212, 160), Enum.Material.SmoothPlastic, CFrame.new(0, -.03, 0) * up, CYL)
		add("LabelStripe", Vector3.new(.04, .212, .212), Color3.fromRGB(190, 40, 40), Enum.Material.SmoothPlastic, CFrame.new(0, -.03, 0) * up, CYL)
	elseif code == "c" then
		add("Paper", Vector3.new(.5, .05, .05), Color3.fromRGB(240, 235, 215), Enum.Material.SmoothPlastic, up, CYL)
		add("Filter", Vector3.new(.13, .052, .052), Color3.fromRGB(205, 140, 80), Enum.Material.SmoothPlastic, CFrame.new(0, -.185, 0) * up, CYL)
		local ember = add("Ember", Vector3.new(.03, .056, .056), Color3.fromRGB(255, 95, 35), Enum.Material.Neon, CFrame.new(0, .265, 0) * up, CYL)
		mk("ParticleEmitter", {Rate = 14, Lifetime = NumberRange.new(.8, 1.5), Speed = NumberRange.new(.4, .9),
			Size = NumberSequence.new(.04, .22), Transparency = NumberSequence.new(.55, 1),
			Color = ColorSequence.new(Color3.fromRGB(205, 205, 205)), SpreadAngle = Vector2.new(15, 15),
			Acceleration = Vector3.new(0, 1.2, 0)}, ember)
		mk("PointLight", {Color = Color3.fromRGB(255, 110, 40), Range = 3, Brightness = 1.2}, ember)
	elseif code == "h" then
		ring("CuffA", CFrame.new(0, .15, 0), .15, 10, .045, .06, Color3.fromRGB(165, 172, 184))
		add("LockA", Vector3.new(.09, .09, .09), Color3.fromRGB(70, 75, 85), Enum.Material.Metal, CFrame.new(0, .0, 0))
		for i = 1, 3 do
			add("Link" .. i, Vector3.new(.04, .1, .04), Color3.fromRGB(150, 158, 168), Enum.Material.Metal,
				CFrame.new(0, -.05 - (i - 1) * .09, 0) * CFrame.Angles(0, (i % 2) * math.rad(90), 0))
		end
		ring("CuffB", CFrame.new(0, -.4, 0) * CFrame.Angles(0, math.rad(90), 0), .15, 10, .045, .06, Color3.fromRGB(165, 172, 184))
		add("LockB", Vector3.new(.09, .09, .09), Color3.fromRGB(70, 75, 85), Enum.Material.Metal, CFrame.new(0, -.25, 0))
	end
	return model, root
end

local GEST = {
	m = {deg = 84, elb = 0,   rest = CFrame.new(),                           act = CFrame.Angles(math.rad(-12), math.rad(38), 0)},
	b = {deg = 90, elb = 75,  rest = CFrame.Angles(math.rad(-10), 0, 0),     act = CFrame.Angles(math.rad(-55), 0, 0)},
	c = {deg = 80, elb = 125, rest = CFrame.Angles(math.pi, 0, 0),           act = CFrame.Angles(math.pi, 0, math.rad(18))},
	h = {deg = 76, elb = 0,   rest = CFrame.new(),                           act = CFrame.Angles(math.rad(22), 0, 0)},
}

local function playItemModel(code, userId)
	local ch = charOf(userId)
	local g = GEST[code]
	if not ch or not g then return end
	local arm = newArm(ch, "Left")
	if not arm then return end
	if gun.itemModel then gun.itemModel:Destroy() gun.itemModel = nil end
	local model, root = buildItem(code, ch)
	local weld = mk("Weld", {Name = "ItemGrip", Part0 = arm.hand, Part1 = root, C0 = arm.grip * g.rest}, root)
	gun.itemModel, gun.itemArm = model, arm
	local restCF, actCF = arm.grip * g.rest, arm.grip * g.act
	local dur = math.max(T.item, 2.0)

	task.spawn(function()
		armPose(arm, g.deg, g.elb, 0.4, Enum.EasingStyle.Quint)
		task.wait(0.45)
		if not model.Parent then return end
		tweenC0(weld, 0.55, actCF, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		local hold = math.max(dur - 1.55, 0.4)
		if code == "h" then
			local t0 = os.clock()
			while alive and weld.Parent and os.clock() - t0 < hold + 0.55 do
				local t = os.clock() - t0
				weld.C0 = actCF * CFrame.Angles(math.sin(t * 11) * 0.28, 0, math.sin(t * 7) * 0.12)
				task.wait()
			end
		else
			task.wait(hold + 0.55)
		end
		if not model.Parent then return end
		tweenC0(weld, 0.3, restCF, Enum.EasingStyle.Sine)
		armRestore(arm, 0.4)
		task.wait(0.45)
		if model.Parent then model:Destroy() end
		if gun.itemModel == model then gun.itemModel, gun.itemArm = nil, nil end
	end)
end


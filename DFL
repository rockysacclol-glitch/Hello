local net = {sent = 0, recv = 0, err = ""}
local outbox, seq = {}, os.time()
local relay = {ws = nil, ok = false}
local function transmit(text)
	if CONFIG.relay.enabled then
		if not (relay.ok and relay.ws) then net.err = "relay offline" return end
		local ok, err = pcall(function() relay.ws:Send(HttpService:JSONEncode({u = me, t = text})) end)
		if ok then net.sent += 1 else net.err = tostring(err):sub(1, 60) end
		return
	end
	local ok, err = pcall(function()
		local done = false
		if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
			local chans = TCS:FindFirstChild("TextChannels")
			local ch = chans and (chans:FindFirstChild("RBXGeneral") or chans:FindFirstChildOfClass("TextChannel"))
			if ch then ch:SendAsync(text) done = true end
		end
		if not done then
			local ev = RS:FindFirstChild("DefaultChatSystemChatEvents")
			local say = ev and ev:FindFirstChild("SayMessageRequest")
			if say then say:FireServer(text, "All") done = true end
		end
		if not done then error("no chat channel found") end
	end)
	if ok then net.sent += 1 else net.err = tostring(err):sub(1, 60) end
end
local function send(text)
	seq += 1
	table.insert(outbox, PREFIX .. enc(seq) .. ";" .. text)
	if #outbox > 300 then table.remove(outbox, 1) end
end
task.spawn(function()
	while alive do
		if USE_NTFY then task.wait(0.5) continue end
		local m = table.remove(outbox, 1)
		if m then
			task.spawn(transmit, m)
			task.wait(CONFIG.relay.enabled and 0.08 or 0.7)
		else
			task.wait(0.1)
		end
	end
end)
local ALWAYS = {LOBBY = true, LST = true, CLOSE = true}
local function humansInGame()
	local list = (G and G.order) or (lobby and lobby.members) or {}
	for _, id in ipairs(list) do if id ~= me and not isBot(id) then return true end end
	return false
end
local function bcast(cmd, ...)
	local args = {...}
	for i, v in ipairs(args) do args[i] = tostring(v) end
	if ALWAYS[cmd] or humansInGame() then send(cmd .. ":" .. table.concat(args, ":")) end
	local ok, err = pcall(apply, cmd, args)
	if not ok then net.err = tostring(err):sub(1, 60) warn("[RR] " .. cmd .. ": " .. tostring(err)) end
end


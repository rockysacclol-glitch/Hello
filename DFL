	mk("ParticleEmitter", {Name = "Sparks", Enabled = false, Lifetime = NumberRange.new(.15, .35),
		Speed = NumberRange.new(12, 24), Size = NumberSequence.new(.12, 0),
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 90)), LightEmission = 1,
		SpreadAngle = Vector2.new(25, 25)}, muzzle)
	mk("PointLight", {Name = "Flash", Enabled = false, Brightness = 6, Range = 10, Color = Color3.fromRGB(255, 190, 100)}, muzzle)
	model.PrimaryPart = root
	local function cylSpin(base, a) return base * CFrame.Angles(a, 0, 0) end
	local function hammerCock(base) return base * CFrame.Angles(math.rad(-38), 0, 0) end

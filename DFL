	if cmd == "JOIN" then
		if lobby and lobby.host == me and not G and #lobby.members < MAX_PLAYERS and not table.find(lobby.members, sender) then
			table.insert(lobby.members, sender)
			bcast("LST", enc(me), idsStr(lobby.members))
		end
	elseif cmd == "LEAVE" then
		if G then hostPlayerLeft(sender)
		elseif lobby and lobby.host == me then
			local i = table.find(lobby.members, sender)
			if i then table.remove(lobby.members, i) bcast("LST", enc(me), idsStr(lobby.members)) end
		end
	elseif cmd == "ACT" then
		hostAct(sender, p[2], p[3], p[4])
	end
end

local seen = {}
local function onMessage(sender, text)
	if sender == me or type(text) ~= "string" or text:sub(1, #PREFIX) ~= PREFIX then return end
	local sq, body = text:sub(#PREFIX + 1):match("^(%w+);(.*)$")
	if not sq then return end
	local key = sender .. ":" .. sq
	if seen[key] then return end
	seen[key] = true
	net.recv += 1
	local parts = split(body, ":")
	local cmd = table.remove(parts, 1)
	local h = parts[1] and dec(parts[1])
	if not h then return end
	local ok, err = pcall(function()
		if cmd == "JOIN" or cmd == "LEAVE" or cmd == "ACT" then
			if h == me then hostHandle(sender, cmd, parts) end
		elseif h == sender then
			apply(cmd, parts)
		end
	end)
	if not ok then net.err = tostring(err):sub(1, 60) warn("[RR] " .. tostring(err)) end
end


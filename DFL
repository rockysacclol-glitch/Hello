local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local B36 = "0123456789abcdefghijklmnopqrstuvwxyz"
local function enc(n) n = math.floor(n) local s = "" repeat local d = n % 36 s = B36:sub(d + 1, d + 1) .. s n = (n - d) / 36 until n == 0 return s end
local function dec(s) return tonumber(s, 36) end
local function split(s, sep) local t = {} for part in (s .. sep):gmatch("(.-)" .. sep) do t[#t + 1] = part end return t end
local BOT_BASE = 9000000000
local function isBot(id) return id >= BOT_BASE end
local function nameOf(id)
	if isBot(id) then return "Bot " .. (id - BOT_BASE) end
	local p = Players:GetPlayerByUserId(id)
	return p and p.DisplayName or "?"
end
local function charOf(id) local p = Players:GetPlayerByUserId(id) return p and p.Character end
local function parseIds(s) local t = {} for _, x in ipairs(split(s or "", ",")) do local n = dec(x) if n then t[#t + 1] = n end end return t end
local function idsStr(t) local r = {} for _, id in ipairs(t) do r[#r + 1] = enc(id) end return table.concat(r, ",") end
local function shuffle(t) for i = #t, 2, -1 do local j = math.random(i) t[i], t[j] = t[j], t[i] end end
local function rand(a, b) return a + math.random() * (b - a) end

local SFX_FALLBACK = {item = "click", death = "hit"}
local function snd(name, vol, speed)
	local id = CONFIG.sfx[name] or CONFIG.sfx[SFX_FALLBACK[name] or ""]
	if not id or id == "" then return end
	local s = mk("Sound", {SoundId = id, Volume = (CONFIG.sfxVolume[name] or 1) * (vol or 1), PlaybackSpeed = speed or 1}, SoundService)
	s.Ended:Connect(function() s:Destroy() end)
	task.delay(10, function() if s.Parent then s:Destroy() end end)
	s:Play()
end


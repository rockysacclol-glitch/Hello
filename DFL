local function stopSeatLock()
	if roomSeatLockConn then roomSeatLockConn:Disconnect(); roomSeatLockConn = nil end
	if roomJumpBound then pcall(function() CAS:UnbindAction(CONFIG.seating.jumpActionName) end); roomJumpBound = false end
	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if hum and savedJumpSettings then
		pcall(function()
			hum.JumpPower = savedJumpSettings.jumpPower
			hum.JumpHeight = savedJumpSettings.jumpHeight
			hum.AutoRotate = savedJumpSettings.autoRotate
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, savedJumpSettings.jumpingEnabled)
		end)
	end
	savedJumpSettings = nil
end

local function startSeatLock()
	if not CONFIG.seating.forceSit or not roomSeat then return end
	stopSeatLock()
	local character = lp.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	savedJumpSettings = {jumpPower = hum.JumpPower, jumpHeight = hum.JumpHeight, autoRotate = hum.AutoRotate,
		jumpingEnabled = hum:GetStateEnabled(Enum.HumanoidStateType.Jumping)}
	hum.JumpPower, hum.JumpHeight, hum.AutoRotate = 0, 0, false
	pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)
	CAS:BindActionAtPriority(CONFIG.seating.jumpActionName, function() return Enum.ContextActionResult.Sink end,
		false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	roomJumpBound = true
	local lastResit = 0
	roomSeatLockConn = RunService.Heartbeat:Connect(function()
		if not alive or not roomModel or not roomSeat or not roomSeat.Parent then stopSeatLock(); return end
		local c = lp.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if not h or h.Health <= 0 then return end
		if h.SeatPart ~= roomSeat and os.clock() - lastResit > 0.2 then
			lastResit = os.clock()
			pcall(function() roomSeat:Sit(h) end)
		end
	end)
end

local function clearRoom(restore)
	stopSeatLock()
	if roomModel then roomModel:Destroy() roomModel = nil end
	if roomSeat then pcall(function() roomSeat:Destroy() end) roomSeat = nil end
	if restore then
		if roomOriginalCFrame then
			local ch = lp.Character
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if root then root.CFrame = roomOriginalCFrame end
			if hum then hum.Sit = false end
		end
		roomCenter, roomCount, roomOriginalCFrame = nil, 0, nil
		if roomOldAmbient then pcall(function() Lighting.Ambient = roomOldAmbient end) end
		if roomOldOutdoor then pcall(function() Lighting.OutdoorAmbient = roomOldOutdoor end) end
		if roomOldBrightness then pcall(function() Lighting.Brightness = roomOldBrightness end) end
		roomOldAmbient, roomOldOutdoor, roomOldBrightness = nil, nil, nil
	end
end
local function updateRoom()
	if not alive then return end
	local members = G and G.order or (lobby and lobby.members) or nil
	if not members or #members == 0 then
		if roomModel then clearRoom(true) end
		return
	end
	local count = math.clamp(#members, 2, math.min(CONFIG.seating.chairCountMax, math.max(2, MAX_PLAYERS)))
	local ch = lp.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then return end
	if roomModel and roomCount == count then
		if roomSeat then startSeatLock() end
		return
	end
	local firstBuild = roomModel == nil
	local oldCenter = roomCenter
	if roomModel then clearRoom(false) end
	if firstBuild then
		roomOriginalCFrame = root.CFrame
		roomCenter = root.Position + root.CFrame.LookVector * 5
		roomOldAmbient, roomOldOutdoor, roomOldBrightness = Lighting.Ambient, Lighting.OutdoorAmbient, Lighting.Brightness
	end
	local center = roomCenter or oldCenter or root.Position
	roomCenter = center
	roomCount = count
	local template = workspace:FindFirstChild(CONFIG.seating.roomTemplateName) or workspace:FindFirstChild("Room")
	local importedRoom = template and template:IsA("Model")
	local chairTemplate = importedRoom and template:FindFirstChild("Chair4", true) or nil
	if chairTemplate and not (chairTemplate:IsA("Model") or chairTemplate:IsA("BasePart")) then chairTemplate = nil end
	roomModel = importedRoom and template:Clone() or Instance.new("Model")
	roomModel.Name = "RR_LocalDarkRoom"
	roomModel.Parent = workspace
	if importedRoom then
		local pivot = roomModel:GetPivot()
		roomModel:PivotTo(CFrame.new(center) * (pivot - pivot.Position))
		local templateChairCopy = roomModel:FindFirstChild("Chair4", true)
		if templateChairCopy then templateChairCopy:Destroy() end
	end
	local floorY = center.Y - 3
	local radius = math.max(10, count * 1.8 + 5)
	local wallH = 10
	local dark = Color3.fromRGB(16, 16, 20)
	local tableRadius = math.clamp(2.4 + count * 0.22, 2.8, 4.5)
	if importedRoom then
		pcall(function()
			local boxCF, boxSize = roomModel:GetBoundingBox()
			floorY = boxCF.Position.Y - boxSize.Y * 0.5
			local tableObj = roomModel:FindFirstChild("Table", true)
			if tableObj then
				local tableSize
				if tableObj:IsA("Model") then local _, size = tableObj:GetBoundingBox(); tableSize = size
				elseif tableObj:IsA("BasePart") then tableSize = tableObj.Size end
				if tableSize then tableRadius = math.clamp(math.max(tableSize.X, tableSize.Z) * 0.5, 2.2, 5.5) end
			end
		end)
	end
	if not importedRoom then
		roomPart(roomModel, "Floor", Vector3.new(radius * 2, 1, radius * 2), CFrame.new(center.X, floorY, center.Z), Color3.fromRGB(25, 24, 27), Enum.Material.Slate)
		roomPart(roomModel, "Ceiling", Vector3.new(radius * 2, 1, radius * 2), CFrame.new(center.X, floorY + wallH, center.Z), Color3.fromRGB(10, 10, 13), Enum.Material.Slate)
		roomPart(roomModel, "NorthWall", Vector3.new(radius * 2, wallH, 1), CFrame.new(center.X, floorY + wallH/2, center.Z - radius), dark, Enum.Material.Slate)
		roomPart(roomModel, "SouthWall", Vector3.new(radius * 2, wallH, 1), CFrame.new(center.X, floorY + wallH/2, center.Z + radius), dark, Enum.Material.Slate)
		roomPart(roomModel, "WestWall", Vector3.new(1, wallH, radius * 2), CFrame.new(center.X - radius, floorY + wallH/2, center.Z), dark, Enum.Material.Slate)
		roomPart(roomModel, "EastWall", Vector3.new(1, wallH, radius * 2), CFrame.new(center.X + radius, floorY + wallH/2, center.Z), dark, Enum.Material.Slate)
		local tableTop = floorY + 3.1
		local tablePart = roomPart(roomModel, "RoundTableTop", Vector3.new(tableRadius * 2, 0.45, tableRadius * 2), CFrame.new(center.X, tableTop, center.Z), Color3.fromRGB(48, 29, 24), Enum.Material.Wood)
		tablePart.Shape = Enum.PartType.Cylinder
		tablePart.CFrame = CFrame.new(center.X, tableTop, center.Z) * CFrame.Angles(0, 0, math.rad(90))
		local leg = roomPart(roomModel, "TablePedestal", Vector3.new(1.1, 2.5, 1.1), CFrame.new(center.X, tableTop - 1.45, center.Z), Color3.fromRGB(32, 25, 23), Enum.Material.Wood)
		leg.Shape = Enum.PartType.Cylinder
		leg.CFrame = CFrame.new(center.X, tableTop - 1.45, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	end
	for i = 1, count do
		local angle = (i - 1) * math.pi * 2 / count - math.pi / 2
		local seatR = tableRadius + 2.2
		local x, z = center.X + math.cos(angle) * seatR, center.Z + math.sin(angle) * seatR
		local seatCF = CFrame.lookAt(Vector3.new(x, floorY + 1.25, z), Vector3.new(center.X, floorY + 1.25, center.Z))
		local chair = Instance.new("Model")
		chair.Name = "Chair" .. i
		chair.Parent = roomModel
		if chairTemplate then
			local visual = chairTemplate:Clone()

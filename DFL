		TextSize = o.size or 14, TextColor3 = o.color or C.text, TextXAlignment = o.align or Enum.TextXAlignment.Left,
		Size = o.sz or UDim2.new(1, 0, 0, o.h or 18), Position = o.pos or UDim2.new(), LayoutOrder = parent == content and nextOrd() or 0}, parent)
end
local function section(txt) lbl(content, txt, {size = 11, color = C.muted, font = Enum.Font.GothamBold, h = 14}) end
local function button(parent, txt, color, cb, enabled, h, sz, pos)
	local off = enabled == false
	local b = mk("TextButton", {Size = sz or UDim2.new(1, 0, 0, h or 36), Position = pos or UDim2.new(), BackgroundColor3 = off and C.disabled or color, Text = txt, RichText = true,
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = off and C.muted or Color3.new(1, 1, 1), AutoButtonColor = false, BorderSizePixel = 0,
		LayoutOrder = parent == content and nextOrd() or 0}, parent)
	corner(b, 7)
	mk("UIStroke", {Color = Color3.fromRGB(255, 255, 255), Transparency = .82, Thickness = 1}, b)
	if not off then
		local hover = color:Lerp(Color3.new(1, 1, 1), 0.18)
		b.MouseEnter:Connect(function() TS:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = hover}):Play() end)
		b.MouseLeave:Connect(function() TS:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = color}):Play() end)
		b.Activated:Connect(cb)
	end
	return b
end
local function pills(parent, n, max, color, pos)
	local row = mk("Frame", {BackgroundTransparency = 1, Position = pos, Size = UDim2.fromOffset(max * 18, 12)}, parent)
	for i = 1, max do
		local p = mk("Frame", {Size = UDim2.fromOffset(14, 10), Position = UDim2.fromOffset((i - 1) * 18, 0), BackgroundColor3 = i <= n and color or C.disabled, BorderSizePixel = 0}, row)
		corner(p, 3)
	end
end

local lastAct = 0
lobbyRefreshAt = 0
local function act(action, a1, a2)
	if not G or G.busy or G.over then return end
	if os.clock() < (G.waitUntil or 0) or os.clock() - lastAct < 0.5 then return end
	lastAct = os.clock()
	if G.host == me then
		hostAct(me, action, a1 or "", a2 or "")
	else
		G.waitUntil = os.clock() + 4
		send(("ACT:%s:%s:%s:%s"):format(enc(G.host), action, a1 or "", a2 or ""))
	end
	refresh()
end

local function opponents(onlyUncuffed)
	local t = {}
	for _, id in ipairs(G.order) do
		if id ~= me and (G.lives[id] or 0) > 0 and not (onlyUncuffed and G.cuff[id]) then t[#t + 1] = id end
	end
	return t
end
local function useItem(code)
	if code == "h" then
		local opps = opponents(true)
		if #opps == 0 then log("<font color='#aaaaaa'>Nobody to handcuff</font>") return end
		if #opps == 1 then act("i", "h", enc(opps[1])) else cuffPick = true refresh() end
	elseif code == "c" and (G.lives[me] or 0) >= CONFIG.rules.maxLives then
		log("<font color='#aaaaaa'>You are already at full health</font>")
	else
		act("i", code, "")
	end
end

local function createLobby()
	if lobby or G then return end
	lobby = {host = me, members = {me}}
	bcast("LOBBY", enc(me), 1)
	refresh()
end
local function addBot()
	if not lobby or lobby.host ~= me or G or #lobby.members >= MAX_PLAYERS then return end
	local n = 1
	while table.find(lobby.members, BOT_BASE + n) do n += 1 end
	table.insert(lobby.members, BOT_BASE + n)
	bcast("LST", enc(me), idsStr(lobby.members))
end
local function startGame()
	if not lobby or lobby.host ~= me or #lobby.members < 2 or G or HS then return end
	local members = {}
	for _, id in ipairs(lobby.members) do members[#members + 1] = id end
	hostNew(members)
	startRound(members[math.random(#members)])
end
local function leave()
	if G then
		if G.host == me then bcast("CLOSE", enc(me)) else send("LEAVE:" .. enc(G.host)) endGame() end
	elseif lobby then
		if lobby.host == me then bcast("CLOSE", enc(me)) else send("LEAVE:" .. enc(lobby.host)) lobby = nil end
	end
	refresh()
end


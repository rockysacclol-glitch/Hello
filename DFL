local ragdolls = {}
local function unragdoll(ch)
	local info = ragdolls[ch]
	if not info then return end
	ragdolls[ch] = nil
	for _, o in ipairs(info.extra) do pcall(function() o:Destroy() end) end
	for _, m in ipairs(info.motors) do pcall(function() m.Enabled = true end) end
	local hum, root = ch:FindFirstChildOfClass("Humanoid"), ch:FindFirstChild("HumanoidRootPart")
	if root and ch == lp.Character and hum and hum.Health > 0 then
		local _, y = root.CFrame:ToOrientation()
		root.CFrame = CFrame.new(root.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, y, 0)
	end
	if hum and hum.Health > 0 then hum.PlatformStand = false hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
end
local function ragdoll(ch, perm, dir)
	if not ch or ragdolls[ch] then return end
	local hum, root = ch:FindFirstChildOfClass("Humanoid"), ch:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	local info = {motors = {}, extra = {}, perm = perm}
	ragdolls[ch] = info
	hum.PlatformStand = true
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
	for _, m in ipairs(ch:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Part0 ~= root then
			local a0 = mk("Attachment", {CFrame = m.C0}, m.Part0)
			local a1 = mk("Attachment", {CFrame = m.C1}, m.Part1)
			local b = mk("BallSocketConstraint", {Attachment0 = a0, Attachment1 = a1, LimitsEnabled = true,
				TwistLimitsEnabled = true, UpperAngle = 50, TwistLowerAngle = -40, TwistUpperAngle = 40}, m.Part0)
			m.Enabled = false
			m.Part1.CanCollide = true
			table.insert(info.motors, m)
			table.insert(info.extra, a0) table.insert(info.extra, a1) table.insert(info.extra, b)
		end
	end
	local R = CONFIG.ragdoll
	root.AssemblyLinearVelocity = (dir or Vector3.zero) * R.force + Vector3.new(0, R.upForce, 0)
	root.AssemblyAngularVelocity = Vector3.new(math.random(-R.spin, R.spin), 0, math.random(-R.spin, R.spin))
	if not perm then
		task.delay(R.getUpTime, function() if ragdolls[ch] == info and not info.perm then unragdoll(ch) end end)
	end
end

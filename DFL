	local dead = (G.lives[id] or 0) <= 0
	local isH = G.holder == id and not dead
	local f = card(52, isH and Color3.fromRGB(54, 46, 26) or C.panel)
	local stripe = mk("Frame", {Size = UDim2.new(0, 4, 1, -14), Position = UDim2.fromOffset(7, 7), BorderSizePixel = 0,
		BackgroundColor3 = dead and C.disabled or (isH and C.gold or C.panel2)}, f)
	corner(stripe, 2)
	local nm = nameOf(id) .. (id == me and " (you)" or "")
	lbl(f, dead and ("<s>" .. nm .. "</s>") or ("<b>" .. nm .. "</b>"), {pos = UDim2.fromOffset(20, 6), sz = UDim2.new(1, -120, 0, 18), color = dead and C.muted or C.text})

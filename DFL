	detail("Grip", Vector3.new(.21, .48, .25), CONFIG.gun.grip, CFrame.new(0, -.36, .23) * CFrame.Angles(math.rad(-15), 0, 0), Enum.Material.Wood)
	detail("GripCap", Vector3.new(.23, .06, .27), Color3.fromRGB(48, 32, 23), CFrame.new(0, -.61, .24))
	detail("TriggerGuard", Vector3.new(.20, .035, .23), Color3.fromRGB(85, 85, 90), CFrame.new(0, -.20, .02))
	local trigger, triggerWeld = detail("Trigger", Vector3.new(.045, .12, .045), Color3.fromRGB(25, 25, 27), CFrame.new(0, -.23, -.015))
	local hammer, hammerWeld = detail("Hammer", Vector3.new(.10, .14, .09), Color3.fromRGB(125, 125, 130), CFrame.new(0, .19, .20))
	local muzzle = detail("Muzzle", Vector3.new(.08, .08, .04), Color3.new(1, 1, 1), CFrame.new(0, .06, -1.03), nil, nil, 1)
	local flashPart = detail("FlashBall", Vector3.new(.22, .22, .5), Color3.fromRGB(255, 210, 110), CFrame.new(0, .06, -1.28), Enum.Material.Neon, Enum.PartType.Ball, 1)
	mk("ParticleEmitter", {Name = "Smoke", Enabled = false, Lifetime = NumberRange.new(.5, 1.1),
		Speed = NumberRange.new(1, 3), Size = NumberSequence.new(.15, .8),
		Transparency = NumberSequence.new(.35, 1), Color = ColorSequence.new(Color3.fromRGB(190, 190, 190)),

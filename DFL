local function makeGunModel(parent, name)
	local m1, m2, m3, m4, m5, m6, m7, m8, m9, m10 = makeColtModel(parent, name)
	if m1 then return m1, m2, m3, m4, m5, m6, m7, m8, m9, m10 end
	GUN_GRIP_INV = CFrame.new(0, 0.33, -0.22)

	local model = mk("Model", {Name = name or "RRRevolver"}, parent)
	local function part(n, size, color, material, cf, shape, trans)
		local p = mk("Part", {
			Name = n, Size = size, Color = color, Material = material or Enum.Material.Metal, Transparency = trans or 0,
			CanCollide = false, CanTouch = false, CanQuery = false, Massless = true, CastShadow = false,
			CFrame = cf, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth
		}, model)
		if shape then p.Shape = shape end
		return p
	end
	local root = part("Frame", Vector3.new(.25, .34, .52), CONFIG.gun.frame, Enum.Material.Metal, CFrame.new())
	local function attach(p, to)
		return mk("Weld", {Part0 = to, Part1 = p, C0 = to.CFrame:Inverse() * p.CFrame}, p)
	end
	local function detail(n, size, color, cf, mat, shape, trans, to)
		local p = part(n, size, color, mat, cf, shape, trans)
		local w = attach(p, to or root)
		return p, w
	end

local function burst(ch, color, n, finalHit)
	if not ch then return end
	local head = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
	if not head then return end
	local tint = color or Color3.fromRGB(170, 24, 30)
	local amount = finalHit and math.max(n or 0, CONFIG.bloodFX.lastLifeBurst or 34) or (n or 24)
	local e = mk("ParticleEmitter", {
		Name = "RR_StylizedImpactParticles", Enabled = false,
		Lifetime = finalHit and NumberRange.new(0.35, 0.9) or NumberRange.new(0.25, 0.7),
		Speed = finalHit and NumberRange.new(8, 17) or NumberRange.new(5, 12),
		Size = NumberSequence.new({NumberSequenceKeypoint.new(0, finalHit and 0.22 or 0.16), NumberSequenceKeypoint.new(1, 0)}),
		Color = ColorSequence.new(tint), SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -26, 0), Drag = 2.2, Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180), LightEmission = 0.05,
	}, head)
	e:Emit(math.clamp(amount, 1, 60))
	task.delay(1.5, function() if e.Parent then e:Destroy() end end)
	if finalHit then abstractImpactDebris(ch) end
	if not CONFIG.bloodFX.enabled then return end
	for i = 1, math.clamp(CONFIG.bloodFX.dropletCount + (finalHit and 6 or 0), 0, 20) do
		local size = math.clamp(CONFIG.bloodFX.dropletSize, 0.04, 0.22) * rand(0.55, 1.3)
		local drop = mk("Part", {
			Name = "RR_StylizedRedDroplet", Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size), Color = tint, Material = Enum.Material.SmoothPlastic,
			Transparency = 0.1, Anchored = false, CanCollide = false, CanTouch = true, CanQuery = false,
			Massless = true, CastShadow = false,
			CFrame = head.CFrame * CFrame.new(rand(-0.28, 0.28), rand(-0.15, 0.4), rand(-0.28, 0.28)),
		}, workspace)
		drop.AssemblyLinearVelocity = Vector3.new(rand(-16, 16), rand(5, 17), rand(-16, 16))
		local touched, touchConn = false, nil
		touchConn = drop.Touched:Connect(function(hit)
			if touched or not hit or hit == drop or hit:IsDescendantOf(ch) then return end
			touched = true
			if touchConn then touchConn:Disconnect() end
			playImpactSound(hit:IsA("BasePart") and hit or drop, finalHit)
			local ok, normal = pcall(function()
				local delta = drop.Position - hit.Position
				return delta.Magnitude > 0.001 and delta.Unit or Vector3.yAxis
			end)
			if ok then makeTemporaryStain(hit, drop.Position, normal, tint) end
			drop.Anchored, drop.CanTouch = true, false
			drop.AssemblyLinearVelocity = Vector3.zero
			TS:Create(drop, TweenInfo.new(0.35), {Transparency = 1, Size = Vector3.new(0.01, 0.01, 0.01)}):Play()
			task.delay(0.4, function() if drop.Parent then drop:Destroy() end end)
		end)
		task.delay(math.clamp(CONFIG.bloodFX.dropletLifetime, 0.5, 4), function()
			if touchConn then touchConn:Disconnect() end
			if drop.Parent then drop:Destroy() end
		end)
	end

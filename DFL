local bases = setmetatable({}, {__mode = "k"})
local function baseOf(j) if not bases[j] then bases[j] = j.C0 end return bases[j] end

local function pickAxis(joint)
	local bestAx, bestSg, bestScore = Vector3.xAxis, 1, -math.huge
	for _, ax in ipairs({Vector3.xAxis, Vector3.zAxis}) do
		for _, sg in ipairs({1, -1}) do
			local cf = baseOf(joint) * CFrame.fromAxisAngle(ax, sg * math.rad(60)) * joint.C1:Inverse()
			local v = cf:VectorToWorldSpace(Vector3.new(0, -1, 0))
			local score = -v.Z - math.abs(v.X) * 0.6
			if score > bestScore then bestScore, bestAx, bestSg = score, ax, sg end
		end
	end
	return bestAx, bestSg
end

local function tweenC0(obj, dur, goal, style, dir)
	if not obj or not obj.Parent then return end
	if dur <= 0 then obj.C0 = goal return end
	local tw = TS:Create(obj, TweenInfo.new(dur, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.Out), {C0 = goal})
	tw:Play()
	return tw
end

local function newArm(ch, side)
	if not ch then return end
	local r15 = ch:FindFirstChild(side .. "Hand") ~= nil
	local hand = ch:FindFirstChild(side .. "Hand") or ch:FindFirstChild(side .. " Arm")
	local shoulder, elbow
	if r15 then
		local ua = ch:FindFirstChild(side .. "UpperArm")
		shoulder = ua and ua:FindFirstChild(side .. "Shoulder")
		local la = ch:FindFirstChild(side .. "LowerArm")
		elbow = la and la:FindFirstChild(side .. "Elbow")
	else
		local t = ch:FindFirstChild("Torso")
		shoulder = t and t:FindFirstChild(side .. " Shoulder")
	end
	if not hand or not shoulder then return end
	local arm = {side = side, r15 = r15, hand = hand, shoulder = shoulder, elbow = elbow, deg = 0, elb = 0, overrideActive = false}
	arm.sBase = baseOf(shoulder)
	arm.sAx, arm.sSg = pickAxis(shoulder)
	if elbow then arm.eBase = baseOf(elbow) arm.eAx, arm.eSg = pickAxis(elbow) end
	arm.grip = CFrame.new(0, r15 and -0.1 or -0.95, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	return arm
end

local function armPose(arm, deg, elb, t, style)
	if not arm or not arm.shoulder or not arm.shoulder.Parent then return end

	arm.overrideActive = not arm.r15
	arm.deg, arm.elb = deg, elb or 0
	local sDeg = deg
	if not arm.elbow then sDeg = math.min(deg + (elb or 0) * 0.45, 165) end
	tweenC0(arm.shoulder, t or 0.4, arm.sBase * CFrame.fromAxisAngle(arm.sAx, arm.sSg * math.rad(sDeg)), style or Enum.EasingStyle.Quint)
	if arm.elbow and arm.elbow.Parent then
		tweenC0(arm.elbow, t or 0.4, arm.eBase * CFrame.fromAxisAngle(arm.eAx, arm.eSg * math.rad(elb or 0)), style or Enum.EasingStyle.Quint)
	end
end

local function armRestore(arm, t)
	if not arm then return end
	local duration = t or 0.3
	if not arm.r15 then arm.overrideActive = true end
	local shoulderTween
	if arm.shoulder and arm.shoulder.Parent then shoulderTween = tweenC0(arm.shoulder, duration, arm.sBase) end
	if arm.elbow and arm.elbow.Parent then tweenC0(arm.elbow, duration, arm.eBase) end
	if not arm.r15 then
		if shoulderTween then
			shoulderTween.Completed:Once(function()
				if arm then arm.overrideActive = false end
			end)
		else
			arm.overrideActive = false
		end
	end
end


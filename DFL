function refresh()
	if not alive or not gui.Parent then return end
	local pos = content.CanvasPosition
	ord = 0
	for _, c in ipairs(content:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local ok, err = pcall(function()
		if G then viewGame() elseif lobby then viewLobby() else viewMenu() end
	end)
	if not ok then warn("[RR] UI error: " .. tostring(err)) net.err = "ui: " .. tostring(err):sub(1, 40) end
	content.CanvasPosition = pos
	updateMusic()
	pcall(updateRoom)
end

local function applyLives(str) for i, id in ipairs(G.order) do G.lives[id] = tonumber(str:sub(i, i)) or 0 end end
local function applyCuff(str) for i, id in ipairs(G.order) do G.cuff[id] = str:sub(i, i) == "1" end end
local function decodeItems(str)
	local parts = split(str or "", ",")
	for i, id in ipairs(G.order) do
		local list = {}
		for ch in (parts[i] or ""):gmatch(".") do list[#list + 1] = ch end
		G.items[id] = list
	end
end
local LIVE_TXT, BLANK_TXT = "<font color='#ff4040'>LIVE</font>", "<font color='#5aa0ff'>BLANK</font>"

function endGame()
	for ch in pairs(ragdolls) do unragdoll(ch) end
	clearGun() camRelease() fx.tension(false) fx.bars(false)
	G, lobby, HS = nil, nil, nil
	hostBusy, spun, shells, cuffPick = false, false, {}, false
	refresh()
end

local function resShot(p)
	local shooter, target, live = dec(p[2]), dec(p[3]), p[4] == "l"
	local lives, newHolder, dmg = p[5], dec(p[6]), tonumber(p[9]) or 1
	local liveLeft, blankLeft, cuffs = tonumber(p[7]), tonumber(p[8]), p[10] or ""
	local selfShot = shooter == target
	local sch, tch = charOf(shooter), charOf(target)
	local aimT = selfShot and T.selfAim or T.aim

	if G.holder ~= shooter or not gun.model or gun.id ~= shooter then setHolder(shooter) G.holder = shooter end
	snd("click")
	local shellTxt = ("%d bullets remain in the cylinder"):format(G.bulletsLeft or 6)
	banner(selfShot and (nameOf(shooter) .. " puts the gun to their head...") or (nameOf(shooter) .. " aims at " .. nameOf(target) .. "..."), shellTxt, aimT + T.pause)
	log(selfShot and ("<b>" .. nameOf(shooter) .. "</b> points the gun at themselves") or ("<b>" .. nameOf(shooter) .. "</b> points the gun at <b>" .. nameOf(target) .. "</b>"))
	fx.tension(true) fx.bars(true)
	cinematic(shooter, target, aimT + T.pause)
	if shooter == me and not selfShot then faceTarget(sch, tch) end

	local mine = gun.arm and gun.id == shooter
	if mine then poseGun("ready", 0.38, Enum.EasingStyle.Back) end
	task.wait(0.25)
	if not G then return end
	if mine then poseGun(selfShot and "self" or "aim", 0.55, Enum.EasingStyle.Quint) end
	task.wait(0.75)
	if not G then return end
	task.wait(math.max(0, aimT - 1.0))
	if not G then return end
	if mine then cockHammer() tremble(T.pause, 1.4) end
	task.wait(T.pause)
	if not G then return end

	camCancel()
	fireFx()
	camPunch(live and 14 or 4)
	if live then
		snd("shot") snd("hit")
		fx.flash(Color3.fromRGB(255, 0, 0), 0.3) fx.shake(1.2, 0.55)
		applyLives(lives)
		local dir = Vector3.zero
		local sr, tr = sch and sch:FindFirstChild("HumanoidRootPart"), tch and tch:FindFirstChild("HumanoidRootPart")
		if sr and tr then
			dir = (tr.Position - sr.Position) * Vector3.new(1, 0, 1)
			dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.zero
		elseif selfShot and sr then
			dir = -sr.CFrame.LookVector
		end
		hitFx(tch)
		local remainingLives = G.lives[target] or 0
		local dead = remainingLives <= 0
		local finalHit = remainingLives <= 1
		if not dead and remainingLives == 1 then
			snd("lastLife")
			if CONFIG.bloodFX.finalScreenFlash then
				fx.flash(Color3.fromRGB(160, 0, 12), 0.48)
				fx.shake(1.8, 0.75)
			end
		end
		if finalHit then snd("limbHit", 0.8) end
		if finalHit then snd("finalImpact", 0.75) end
		burst(tch, Color3.fromRGB(150, 12, 25), finalHit and CONFIG.bloodFX.lastLifeBurst or 24, finalHit)
		ragdoll(tch, dead, dir)
		if dead then
			snd("death")
			popText(tch, "ELIMINATED", Color3.fromRGB(255, 50, 50))
			banner("<font color='#ff3030'>" .. nameOf(target):upper() .. " HAS DIED</font>", "eliminated for good", T.after)
			log("<font color='#ff3030'><b>" .. nameOf(target) .. "</b> was killed</font>")
			if target == me and CONFIG.deathKillsCharacter then task.delay(1.8, killMe) end
		else
			popText(tch, "-" .. dmg, Color3.fromRGB(255, 70, 70))
			banner("<font color='#ff4040'>BANG!</font>", nameOf(target) .. " loses " .. dmg .. (dmg > 1 and " lives" or " life"), T.after)
			log("<font color='#ff5050'>BANG</font> - <b>" .. nameOf(target) .. "</b> loses " .. dmg .. (dmg > 1 and " lives" or " life"))
		end
	else
		snd("click")
		fx.shake(0.15, 0.3)
		popText(tch, "CLICK", Color3.fromRGB(110, 170, 255))
		banner("<font color='#5aa0ff'>*CLICK*</font>", "blank", T.after)
		log("<font color='#5aa0ff'>click</font> - blank" .. (selfShot and (" - <b>" .. nameOf(shooter) .. "</b> goes again") or ""))
	end
	G.live, G.blank = liveLeft, blankLeft
	G.bulletsLeft = math.max(0, (liveLeft or 0) + (blankLeft or 0))
	applyCuff(cuffs)
	refresh()
	if mine and gun.id == shooter then task.delay(0.5, function() if gun.id == shooter then poseGun("idle", 0.8, Enum.EasingStyle.Sine) end end) end

	task.wait(T.after * 0.6)
	camRelease() fx.tension(false) fx.bars(false)
	task.wait(T.after * 0.4)
	if not G then return end
	G.holder = newHolder
	setHolder(newHolder)
	refresh()
end

function apply(cmd, p)
	local h = dec(p[1] or "")
	if not h then return end
	if cmd == "LOBBY" then
		if h ~= me then lobbies[h] = {t = os.clock(), n = tonumber(p[2]) or 1} end
		refresh()
	elseif cmd == "HELLO" then
		if lobby and lobby.host == me and not G then bcast("LOBBY", enc(me), #lobby.members) end
	elseif cmd == "LST" then
		local ids = parseIds(p[2])
		if table.find(ids, me) then lobby = {host = h, members = ids} pending = nil
		elseif lobby and lobby.host == h then lobby = nil end
		refresh()
	elseif cmd == "CLOSE" then
		if (lobby and lobby.host == h) or (G and G.host == h) then
			if G then banner("The game was closed", "", 3) endGame() end
			lobby = nil
			refresh()
		end
	elseif cmd == "ROUND" then
		local ids = parseIds(p[2])
		if not table.find(ids, me) then return end
		if G and G.host ~= h then return end
		if not G then
			G = {host = h, order = ids, lives = {}, items = {}, cuff = {}, over = false}
			lobby, pending, cuffPick = nil, nil, false
		end
		applyLives(p[3]) decodeItems(p[8]) applyCuff(p[9] or "")
		G.holder, G.live, G.blank, G.round = dec(p[4]), tonumber(p[5]), tonumber(p[6]), tonumber(p[7])
		G.bulletsLeft = BULLETS_PER_ROUND
		G.busy, G.spun = true, false
		snd("load")
		banner("ROUND " .. G.round, "6 BULLETS IN THE CYLINDER", T.roundIntro - 0.5)
		log(("<b>Round %d</b> begins • 6 bullets loaded"):format(G.round))
		if G.holder ~= gun.id or not gun.model then setHolder(G.holder) end
		refresh()
	elseif cmd == "SPIN" and G then
		G.busy, G.spun = true, true
		snd("spin") spinGunFx()
		banner(nameOf(dec(p[2])) .. " spins the cylinder...", "", T.spin)
		log("<b>" .. nameOf(dec(p[2])) .. "</b> spins the cylinder")
		refresh()
	elseif cmd == "ITEM" and G then
		local user, code, tgt, extra = dec(p[2]), p[3], p[4], p[5]
		local it = ITEMS[code] or {name = "?", desc = ""}
		G.busy = true
		applyLives(p[6]) decodeItems(p[7]) applyCuff(p[8] or "")
		G.live, G.blank = tonumber(p[10]) or G.live, tonumber(p[11]) or G.blank
		G.bulletsLeft = math.max(0, (G.live or 0) + (G.blank or 0))
		snd("item")
		local ok, err = pcall(playItemModel, code, user)
		if not ok then warn("[RR] item model: " .. tostring(err)) end
		banner(nameOf(user) .. " uses the " .. it.name, it.desc, T.item)
		log("<b>" .. nameOf(user) .. "</b> uses <font color='#b9a8ff'>" .. it.name .. "</font>")
		if code == "m" and user == me then
			task.delay(0.8, function()
				if G then
					banner("The current shell is " .. (extra == "l" and LIVE_TXT or BLANK_TXT), "only you can see this", T.item)
					log("You peeked: " .. (extra == "l" and LIVE_TXT or BLANK_TXT))
				end
			end)
		elseif code == "b" then
			task.delay(0.8, function()
				if G then
					banner("Ejected a " .. (extra == "l" and LIVE_TXT or BLANK_TXT) .. " shell", "", T.item)
					log("Ejected shell was " .. (extra == "l" and LIVE_TXT or BLANK_TXT))
				end
			end)
		elseif code == "c" then
			fx.flash(Color3.fromRGB(60, 200, 90), 0.8) hitFx(charOf(user), Color3.fromRGB(60, 200, 90))
			popText(charOf(user), "+1", Color3.fromRGB(90, 230, 120))
		elseif code == "h" then
			local t = dec(tgt or "")
			if t then
				log("<b>" .. nameOf(t) .. "</b> is handcuffed") hitFx(charOf(t), Color3.fromRGB(90, 160, 255))
				popText(charOf(t), "CUFFED", Color3.fromRGB(110, 170, 255))
			end
		end
		refresh()
	elseif cmd == "READY" and G then
		G.busy, G.spun, G.waitUntil = false, false, 0
		refresh()
		if G.host == me then botTurn() end
	elseif cmd == "RES" and G then
		G.busy, G.spun = true, false
		refresh()
		task.spawn(function()
			local ok, err = pcall(resShot, p)
			if not ok then warn("[RR] shot error: " .. tostring(err)) net.err = tostring(err):sub(1, 50) end
		end)
	elseif cmd == "LEFT" and G then
		local id = dec(p[2])
		applyLives(p[3])
		G.holder = dec(p[4])
		setHolder(G.holder)
		banner(nameOf(id) .. " left the game", "", 2.5)
		log("<b>" .. nameOf(id) .. "</b> left")
		refresh()
	elseif cmd == "WIN" and G then
		local w = dec(p[2])
		G.over, G.winner = true, w
		camRelease() fx.tension(false) fx.bars(false)
		snd("win")
		banner("<font color='#ffd040'>" .. nameOf(w):upper() .. " WINS</font>", "the last one standing", 8)
		log("<font color='#ffd040'><b>" .. nameOf(w) .. "</b> wins!</font>")
		popText(charOf(w), "WINNER", Color3.fromRGB(255, 208, 64))
		refresh()
		task.delay(10, function() if G and G.over then endGame() end end)
	end
end

local function packLives() local s = "" for _, id in ipairs(HS.order) do s ..= tostring(HS.lives[id] or 0) end return s end
local function packCuff() local s = "" for _, id in ipairs(HS.order) do s ..= HS.cuff[id] and "1" or "0" end return s end
local function packItems()
	local r = {}
	for _, id in ipairs(HS.order) do r[#r + 1] = table.concat(HS.items[id] or {}) end
	return table.concat(r, ",")
end
local function nextAliveHS(id)
	local order = HS.order
	local idx = table.find(order, id) or 1
	for step = 1, #order - 1 do
		local cand = order[(idx - 1 + step) % #order + 1]
		if (HS.lives[cand] or 0) > 0 then return cand end
	end
	return id
end
local function survivors()
	local t = {}
	for _, id in ipairs(HS.order) do if (HS.lives[id] or 0) > 0 then t[#t + 1] = id end end
	return t
end

function hostNew(members)
	HS = {order = members, lives = {}, items = {}, cuff = {}, round = 0, holder = members[1]}
	for _, id in ipairs(members) do
		HS.lives[id] = CONFIG.rules.lives
		HS.items[id] = {}
		HS.cuff[id] = false
	end
	hostBusy, spun = false, false
end

local function dealItems()
	local R = CONFIG.rules
	if not R.items or #R.itemPool == 0 then return end
	for _, id in ipairs(HS.order) do
		if (HS.lives[id] or 0) > 0 then
			for _ = 1, R.itemsPerRound do
				if #HS.items[id] < R.maxItems then
					local i = math.random(#R.itemPool)
					table.insert(HS.items[id], R.itemPool:sub(i, i))
				end
			end
		end
	end
end

function startRound(holder)
	HS.round += 1
	HS.holder, HS.botKnow = holder, nil
	spun = false
	local live, blank = rollShells()
	dealItems()
	hostBusy = true
	bcast("ROUND", enc(me), idsStr(HS.order), packLives(), enc(holder), live, blank, HS.round, packItems(), packCuff())
	task.delay(T.roundIntro, function()
		if HS then bcast("READY", enc(me)) hostBusy = false end
	end)
end

local function resolveCuffs(cand)
	local guard = 0
	while HS.cuff[cand] and guard < 8 do
		HS.cuff[cand] = false
		cand = nextAliveHS(cand)
		guard += 1
	end
	return cand
end

local function hostShoot(from, tgt)
	hostBusy, spun = true, false
	HS.botKnow = nil
	local selfShot = from == tgt
	local live = table.remove(shells, 1)
	local dmg = 1
	if live then HS.lives[tgt] = math.max(0, (HS.lives[tgt] or 0) - dmg) end
	local nextH
	if not selfShot then nextH = tgt elseif live then nextH = nextAliveHS(from) else nextH = from end
	if (HS.lives[nextH] or 0) <= 0 then nextH = nextAliveHS(nextH) end
	nextH = resolveCuffs(nextH)
	HS.holder = nextH
	local l, b = counts()
	bcast("RES", enc(me), enc(from), enc(tgt), live and "l" or "b", packLives(), enc(nextH), l, b, dmg, packCuff())
	local alive_ = survivors()
	local total = (selfShot and T.selfAim or T.aim) + T.pause + T.after + T.pass + 0.6
	task.delay(total, function()
		if not HS then return end
		local liveLeft = (counts())
		if #alive_ <= 1 then
			HS.over = true
			bcast("WIN", enc(me), enc(alive_[1] or from))
			hostBusy = false
		elseif liveLeft == 0 then
			startRound(nextH)
		else
			bcast("READY", enc(me))
			hostBusy = false
		end
	end)
end

local function hostItem(from, code, target)
	local list = HS.items[from]
	local idx = list and table.find(list, code)
	if not idx then return end
	local extra, tgtStr = "", ""
	local ejectedLive = false
	if code == "m" then
		if #shells == 0 then return end
		extra = shells[1] and "l" or "b"
		if isBot(from) then HS.botKnow = {id = from, live = shells[1]} end
	elseif code == "b" then
		if #shells == 0 then return end
		local live = table.remove(shells, 1)
		ejectedLive = live
		extra = live and "l" or "b"
		HS.botKnow = nil
	elseif code == "c" then
		if (HS.lives[from] or 0) >= CONFIG.rules.maxLives then return end
		HS.lives[from] += 1
	elseif code == "h" then
		local t = dec(target or "")
		if not t or t == from or (HS.lives[t] or 0) <= 0 or HS.cuff[t] then return end
		HS.cuff[t] = true
		tgtStr = enc(t)
	else
		return
	end
	table.remove(list, idx)
	hostBusy = true
	local l, b = counts()
	bcast("ITEM", enc(me), enc(from), code, tgtStr, extra, packLives(), packItems(), packCuff(), 0, l, b)
	task.delay(T.item + 0.4, function()
		if not HS then return end
		if code == "b" and (#shells == 0 or ejectedLive) then
			startRound(from)
		else
			bcast("READY", enc(me))
			hostBusy = false
		end
	end)
end

function hostAct(from, action, a1, a2)
	if not HS or HS.over or hostBusy or HS.holder ~= from or (HS.lives[from] or 0) <= 0 then return end
	if action == "p" then
		if spun and CONFIG.rules.spinOncePerTurn then return end
		spun, hostBusy = true, true
		HS.botKnow = nil
		shuffle(shells)
		bcast("SPIN", enc(me), enc(from))
		task.delay(T.spin + 0.3, function()
			if HS then bcast("READY", enc(me)) hostBusy = false end
		end)
	elseif action == "i" then
		if CONFIG.rules.items then hostItem(from, a1, a2) end
	elseif action == "s" then
		if #shells > 0 then hostShoot(from, from) end
	elseif action == "o" then
		local t = dec(a1 or "")
		if t and t ~= from and (HS.lives[t] or 0) > 0 and #shells > 0 then hostShoot(from, t) end
	end
end

function hostPlayerLeft(id)
	if not HS or HS.over or (HS.lives[id] or 0) <= 0 then return end
	HS.lives[id] = 0
	if HS.holder == id then HS.holder = nextAliveHS(id) end
	bcast("LEFT", enc(me), enc(id), packLives(), enc(HS.holder))
	local s = survivors()
	if #s <= 1 then HS.over = true bcast("WIN", enc(me), enc(s[1] or me)) end
end

function botTurn()
	if not HS or HS.over or HS.botPending then return end
	local h = HS.holder
	if not h or not isBot(h) then return end
	HS.botPending = true
	task.delay(rand(T.botThink[1], T.botThink[2]), function()
		if not HS then return end
		HS.botPending = false
		if HS.over or HS.holder ~= h or hostBusy or (HS.lives[h] or 0) <= 0 then return end
		local list = HS.items[h] or {}
		local function has(c) return table.find(list, c) ~= nil end
		local opp = {}
		for _, id in ipairs(HS.order) do if id ~= h and (HS.lives[id] or 0) > 0 then opp[#opp + 1] = id end end
		if #opp == 0 then return end
		local l, b = counts()
		local pLive = l / math.max(l + b, 1)
		local known = HS.botKnow and HS.botKnow.id == h
		local liveNow = known and HS.botKnow.live
		if has("c") and HS.lives[h] < CONFIG.rules.maxLives then hostAct(h, "i", "c", "")
		elseif has("m") and not known and math.random() < 0.8 then hostAct(h, "i", "m", "")
		else
			local cand = {}
			for _, id in ipairs(opp) do if not HS.cuff[id] then cand[#cand + 1] = id end end
			if has("h") and #cand > 0 and math.random() < 0.5 then
				hostAct(h, "i", "h", enc(cand[math.random(#cand)]))
			else
				local shootSelf
				if known then shootSelf = not liveNow else shootSelf = b > 0 and (l == 0 or math.random() > pLive) end
				if shootSelf then
					hostAct(h, "s", "", "")
				else
					hostAct(h, "o", enc(opp[math.random(#opp)]), "")
				end
			end
		end
		task.delay(1, function() if HS and HS.holder == h and not hostBusy then botTurn() end end)
	end)
end

local function watchPlayer(plr)
	connect(plr.CharacterAdded, function()
		task.wait(0.9)
		if not G then return end
		if plr == lp and not G.over and (G.lives[me] or 1) <= 0 and CONFIG.deathKillsCharacter then killMe() end
		if G.holder == plr.UserId and not G.over then setHolder(G.holder) end
	end)
end
for _, plr in ipairs(Players:GetPlayers()) do watchPlayer(plr) end
connect(Players.PlayerAdded, watchPlayer)

connect(Players.PlayerRemoving, function(plr)
	local id = plr.UserId
	lobbies[id] = nil
	if G and G.host == id then
		banner("The host left", "", 3) endGame()
	elseif G and G.host == me then
		hostPlayerLeft(id)
	elseif lobby and lobby.host == me then
		local i = table.find(lobby.members, id)
		if i then table.remove(lobby.members, i) bcast("LST", enc(me), idsStr(lobby.members)) end
	elseif lobby and lobby.host == id then
		lobby = nil
	end
	refresh()
end)

task.spawn(function()
	local t = 0
	while alive do
		task.wait(1)
		t += 1
		statusLbl.Text = ("chat sent %d | received %d%s"):format(net.sent, net.recv, net.err ~= "" and (" | " .. net.err) or "")
		if lobby and lobby.host == me and not G and not USE_NTFY and t % (CONFIG.relay.enabled and 4 or 10) == 0 then
			local hasBot = false
			for _, id in ipairs(lobby.members) do if isBot(id) then hasBot = true end end
			if CONFIG.relay.enabled or not (hasBot and not humansInGame()) then bcast("LOBBY", enc(me), #lobby.members) end
		end
		if G and G.busy and not G.over and G.stamp and os.clock() - G.stamp > 40 then G.busy = false end
		if G then G.stamp = G.busy and (G.stamp or os.clock()) or nil end
		if not G and not lobby then refresh() end
		if G and not G.busy and (G.waitUntil or 0) > 0 and os.clock() > G.waitUntil then G.waitUntil = 0 refresh() end
	end
end)

local function cleanup()
	alive = false
	pcall(function() if relay.ws then relay.ws:Close() end end)
	for _, c in ipairs(conns) do c:Disconnect() end
	for ch in pairs(ragdolls) do pcall(unragdoll, ch) end
	if armOverrideConnection then pcall(function() armOverrideConnection:Disconnect() end) end
	for j, c0 in pairs(bases) do pcall(function() j.C0 = c0; j.Transform = CFrame.identity end) end
	clearGun()
	pcall(function() clearRoom(true) end)
	camRelease()
	setMusic(nil)
	pcall(function() cc:Destroy() blur:Destroy() end)
	pcall(function() if coltTemplate then coltTemplate:Destroy() end end)
	if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
		pcall(function() TCS.OnIncomingMessage = function() end end)
		pcall(function() TCS.OnBubbleAdded = function() end end)
	end
	gui:Destroy()
	env.RR_CLEANUP = nil
end
env.RR_CLEANUP = cleanup
closeB.Activated:Connect(function() pcall(leave) cleanup() end)


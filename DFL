			if visual:IsA("Model") then boxCF = select(1, visual:GetBoundingBox()); pivotCF = visual:GetPivot()
			else boxCF = visual.CFrame; pivotCF = visual.CFrame end
			local offset = pivotCF:ToObjectSpace(boxCF)
			if visual:IsA("Model") then visual:PivotTo(seatCF * CFrame.new(0, -0.15, 0) * offset:Inverse())
			else visual.CFrame = seatCF * CFrame.new(0, -0.15, 0) end
			if visual:IsA("BasePart") then visual.Anchored = true; visual.CanQuery = false end
			for _, obj in ipairs(visual:GetDescendants()) do if obj:IsA("BasePart") then obj.Anchored = true; obj.CanQuery = false end end
		else
			roomPart(chair, "ChairBack", Vector3.new(2.2, 2, 0.35), seatCF * CFrame.new(0, 1.05, 1.0), Color3.fromRGB(35, 27, 24), Enum.Material.Wood)
			for _, side in ipairs({-1, 1}) do
				roomPart(chair, "ChairLeg_" .. side, Vector3.new(0.18, 1.1, 0.18), seatCF * CFrame.new(side * 0.8, -0.55, -0.75), Color3.fromRGB(25, 21, 20), Enum.Material.Wood)
			end
			roomPart(chair, "ChairVisualSeat", Vector3.new(2.2, 0.45, 2.2), seatCF, Color3.fromRGB(42, 31, 27), Enum.Material.Wood)
		end
		local seat = mk("Seat", {Name = "Seat", Size = Vector3.new(2.0, 0.35, 2.0), CFrame = seatCF,
			Anchored = true, CanCollide = true, CanTouch = true, CanQuery = false, Transparency = 1,
			Material = Enum.Material.Wood, Color = Color3.fromRGB(42, 31, 27)}, chair)
		local labelGui = mk("BillboardGui", {Name = "ChairLabel", Size = UDim2.fromOffset(110, 28), StudsOffset = Vector3.new(0, 2.2, 0), AlwaysOnTop = true, MaxDistance = 35, Adornee = seat}, seat)
		local label = mk("TextLabel", {Name = "Label", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.15,
			BackgroundColor3 = Color3.fromRGB(12, 10, 10), Text = "CHAIR " .. i, TextColor3 = Color3.fromRGB(235, 220, 195),
			TextStrokeTransparency = 0.65, Font = Enum.Font.GothamBold, TextScaled = true}, labelGui)
		mk("UICorner", {CornerRadius = UDim.new(0, 5)}, label)
		if table.find(members, me) == i then roomSeat = seat end
	end
	if not importedRoom then
		local lamp = roomPart(roomModel, "CeilingLamp", Vector3.new(2.5, 0.15, 2.5), CFrame.new(center.X, floorY + wallH - 0.6, center.Z), Color3.fromRGB(120, 95, 70), Enum.Material.Neon)
		mk("PointLight", {Name = "RRTableLight", Color = Color3.fromRGB(255, 190, 130), Brightness = 0.8, Range = radius * 1.6, Shadows = true}, lamp)
	end
	Lighting.Ambient = Color3.fromRGB(20, 18, 22)
	Lighting.OutdoorAmbient = Color3.fromRGB(8, 8, 12)
	Lighting.Brightness = 0.7
	local idx = table.find(members, me)
	if idx then
		local angle = (idx - 1) * math.pi * 2 / count - math.pi / 2
		local seatR = tableRadius + 2.2
		local x, z = center.X + math.cos(angle) * seatR, center.Z + math.sin(angle) * seatR
		local target = CFrame.lookAt(Vector3.new(x, floorY + 2.1, z), Vector3.new(center.X, floorY + 2.1, center.Z))
		root.CFrame = target
		local hum = ch:FindFirstChildOfClass("Humanoid")
		if hum and roomSeat then task.defer(function() if alive and hum.Parent and roomSeat and roomSeat.Parent then roomSeat:Sit(hum); startSeatLock() end end) end
	end
end


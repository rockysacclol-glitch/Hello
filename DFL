local camTweens, camTok = {}, 0
local function camCancel()
	for _, t in ipairs(camTweens) do pcall(function() t:Cancel() end) end
	camTweens = {}
end
local function camTween(cam, info, goal)
	local tw = TS:Create(cam, info, goal)
	tw:Play()
	table.insert(camTweens, tw)
	return tw
end
local function cinematic(sid, tid, hold)
	if not CONFIG.camera.cinematic then return end
	local cam = workspace.CurrentCamera
	local sch, tch = charOf(sid), charOf(tid)
	local sh = sch and sch:FindFirstChild("Head")
	if not cam or not sh then return end
	local th = tch and tch:FindFirstChild("Head")
	camTok += 1
	local tok = camTok
	camCancel()
	local cf0, cf1
	if sid == tid or not th then
		local focus = sh.Position + Vector3.new(0, 0.1, 0)
		local fwd, right = sh.CFrame.LookVector, sh.CFrame.RightVector
		cf0 = CFrame.lookAt(focus + fwd * 6 + right * 2.2 + Vector3.new(0, 0.6, 0), focus)
		cf1 = CFrame.lookAt(focus + fwd * 3.4 + right * 1.3 + Vector3.new(0, 0.3, 0), focus)
	else
		local a, b = sh.Position, th.Position
		local mid, dir = (a + b) / 2, b - a
		local side = dir:Cross(Vector3.yAxis)
		side = side.Magnitude > 0.01 and side.Unit or Vector3.xAxis
		local dist = dir.Magnitude * 0.5 + 7
		local look = dir.Magnitude > 0.01 and dir.Unit or Vector3.zAxis
		cf0 = CFrame.lookAt(mid + side * dist + Vector3.new(0, 2.5, 0), mid)
		cf1 = CFrame.lookAt(mid + side * (dist - 2.6) + Vector3.new(0, 1.5, 0), mid + look * (dir.Magnitude * 0.18))
	end
	cam.CameraType = Enum.CameraType.Scriptable
	camTween(cam, TweenInfo.new(1.0, Enum.EasingStyle.Sine), {CFrame = cf0, FieldOfView = CONFIG.camera.fov})
	task.delay(1.0, function()
		if camTok ~= tok or not alive then return end
		camTween(cam, TweenInfo.new(math.max((hold or 3) - 1.0, 0.4), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{CFrame = cf1, FieldOfView = CONFIG.camera.fov - 10})
	end)
end
local function camPunch(a)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local f = cam.FieldOfView
	TS:Create(cam, TweenInfo.new(0.05), {FieldOfView = f - a}):Play()
	task.delay(0.06, function() TS:Create(cam, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {FieldOfView = f}):Play() end)
end
local function camRelease()
	camTok += 1
	camCancel()
	local cam = workspace.CurrentCamera
	if not cam then return end
	if cam.CameraType == Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Custom end
	TS:Create(cam, TweenInfo.new(0.8), {FieldOfView = baseFov}):Play()
end


local MUSIC = CONFIG.music
local TRACK_ORDER = {"waiting", "lives3", "lives2", "lives1", "dead", "win", "game"}
local EXTS = {".ogg", ".mp3"}
local musicAssets, curAsset, curSound = {}, nil, nil
local getAsset = getcustomasset or getsynasset

local lastHttpErr = "no http function"
local function httpGet(url)
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if req then
		local ok, res = pcall(req, {Url = url, Method = "GET", Headers = {["User-Agent"] = "Mozilla/5.0"}})
		if ok and res and res.Body and (res.StatusCode or 200) < 300 then return res.Body end
		lastHttpErr = ok and ("HTTP " .. tostring(res and res.StatusCode)) or tostring(res)
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok then return body end
	lastHttpErr = tostring(body):sub(1, 80)
end
local function sniffExt(data)
	if type(data) ~= "string" or #data < 1000 then return nil end
	if data:sub(1, 4) == "OggS" then return ".ogg" end
	if data:sub(1, 3) == "ID3" then return ".mp3" end
	local b1, b2 = data:byte(1, 2)
	if b1 == 0xFF and b2 and b2 >= 0xE0 then return ".mp3" end
	return nil
end
local function fadeOutAndKill(s_)
	if not s_ then return end
	local tw = TS:Create(s_, TweenInfo.new(MUSIC.fadeOut, Enum.EasingStyle.Sine), {Volume = 0})
	tw:Play()
	tw.Completed:Connect(function() s_:Destroy() end)
	task.delay(MUSIC.fadeOut + 1, function() if s_.Parent then s_:Destroy() end end)
end
local function setMusic(key)
	local asset
	if key then asset = musicAssets[key] or musicAssets[MUSIC.fallbackKey] end
	if asset == curAsset then return end
	curAsset = asset
	fadeOutAndKill(curSound)
	curSound = nil
	if not asset then return end
	local s_ = mk("Sound", {Name = "RRMusic", SoundId = asset, Looped = true, Volume = 0}, SoundService)
	pcall(function() s_:Play() end)
	TS:Create(s_, TweenInfo.new(MUSIC.fadeIn, Enum.EasingStyle.Sine), {Volume = MUSIC.volume}):Play()
	curSound = s_
	task.spawn(function()
		local t0 = os.clock()
		while alive and s_.Parent and s_.TimeLength == 0 and os.clock() - t0 < 8 do task.wait(0.25) end
		if alive and s_.Parent and s_.TimeLength == 0 then warn("[RR] music file did not load - delete it from the RussianRoulette folder and re-run") end
	end)
end
local function updateMusic()
	if not alive or not MUSIC.enabled then return end
	local key = "waiting"
	if G then
		if G.over then key = (G.winner == me) and "win" or "dead"
		else
			local n
			if MUSIC.lifeMode == "lowest" then
				n = 99
				for _, id in ipairs(G.order) do local l = G.lives[id] or 0 if l > 0 and l < n then n = l end end
				if n == 99 then n = 0 end
			else
				n = G.lives[me] or 0
			end
			key = n <= 0 and "dead" or ("lives" .. math.min(n, 3))
		end
	end
	setMusic(key)
end
task.spawn(function()
	if not MUSIC.enabled then return end
	if not (writefile and isfile and getAsset) then
		warn("[RR] your executor has no writefile/isfile/getcustomasset - music disabled")
		return
	end
	pcall(function() if makefolder and not isfolder(MUSIC.folder) then makefolder(MUSIC.folder) end end)
	for _, key in ipairs(TRACK_ORDER) do
		local t = MUSIC.tracks[key]
		if not alive then return end
		if t then
			local base = (t.file:gsub("%.%w+$", ""))
			local path
			for _, e in ipairs(EXTS) do
				local p = MUSIC.folder .. "/" .. base .. e
				if isfile(p) then path = p break end
			end
			if not path then
				local legacy = MUSIC.folder .. "/" .. t.file
				if isfile(legacy) then path = legacy end
			end
			if path and readfile then
				local ok, data = pcall(readfile, path)
				local ext = ok and sniffExt(data)
				if not ext then
					warn("[RR] '" .. path .. "' is not valid audio, replacing it")
					if delfile then pcall(delfile, path) end
					path = nil
				elseif path:sub(-#ext) ~= ext then
					local np = MUSIC.folder .. "/" .. base .. ext
					pcall(writefile, np, data)
					if delfile then pcall(delfile, path) end
					path = np
				end
			end
			if (not path or MUSIC.redownload) and t.url then
				local urls = type(t.url) == "table" and t.url or {t.url}
				for _, u in ipairs(urls) do
					if u ~= "" then
						local data = httpGet(u)
						local ext = sniffExt(data)
						if ext then
							local np = MUSIC.folder .. "/" .. base .. ext
							pcall(writefile, np, data)
							if isfile(np) then path = np break end
						end
					end
				end
				if not path then warn("[RR] failed to download music track '" .. key .. "' (" .. tostring(lastHttpErr) .. "). Put " .. base .. ".ogg or " .. base .. ".mp3 in your executor workspace/" .. MUSIC.folder .. " folder instead.") end
			end
			if path then
				local ok, asset = pcall(getAsset, path)
				if ok and asset then musicAssets[key] = asset updateMusic() end
			end
		end
	end
end)


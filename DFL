local COLT_B64 = [==[PASTE_ORIGINAL_BLOB_HERE]==]
local coltTemplate = nil
local coltInfo = nil

local function b64dec(s)
	local f = (crypt and crypt.base64decode) or (crypt and crypt.base64 and crypt.base64.decode) or base64decode or base64_decode or (base64 and base64.decode)
	if f then
		local ok, r = pcall(f, s)
		if ok and type(r) == "string" and #r > 100 and r:sub(1, 8) == "<roblox!" then return r end
	end
	local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local map = {}
	for i = 1, 64 do map[A:byte(i)] = i - 1 end
	local out, buf, bits = {}, 0, 0
	for i = 1, #s do
		local v = map[s:byte(i)]
		if v then
			buf = buf * 64 + v
			bits += 6
			if bits >= 8 then
				bits -= 8
				local p2 = 2 ^ bits
				out[#out + 1] = string.char(math.floor(buf / p2))
				buf = buf % p2
			end
		end
	end
	return table.concat(out)
end

local function aabbOf(items)
	local mn, mx = Vector3.one * math.huge, Vector3.one * -math.huge
	for _, it in ipairs(items) do
		local cf, s = it.cf, it.size
		local x, y, z = cf.XVector, cf.YVector, cf.ZVector
		local h = Vector3.new(
			(math.abs(x.X) * s.X + math.abs(y.X) * s.Y + math.abs(z.X) * s.Z) / 2,
			(math.abs(x.Y) * s.X + math.abs(y.Y) * s.Y + math.abs(z.Y) * s.Z) / 2,
			(math.abs(x.Z) * s.X + math.abs(y.Z) * s.Y + math.abs(z.Z) * s.Z) / 2)
		mn = mn:Min(cf.Position - h)
		mx = mx:Max(cf.Position + h)
	end
	return mn, mx
end

local function coltParts(tpl)
	local byName = {}
	for _, p in ipairs(tpl:GetDescendants()) do
		if p:IsA("BasePart") then byName[p.Name] = p end
	end
	local frame, cyl, ham, trg = byName["Cube.001"], byName["Cube.006"], byName["Cube.008"], byName["Cube.007"]
	if not (frame and cyl and ham and trg) then error("Colt.rbxm is missing parts") end
	return byName, frame, cyl, ham, trg
end

local function analyseColt(tpl)
	local GC = CONFIG.gun
	local byName, frame, cylSrc, hamSrc, trgSrc = coltParts(tpl)
	local inv = frame.CFrame:Inverse()
	local raw = {}
	for _, p in pairs(byName) do raw[#raw + 1] = {cf = inv * p.CFrame, size = p.Size, part = p} end
	local function rawPos(p) return (inv * p.CFrame).Position end

	local mn, mx = aabbOf(raw)
	local ext = mx - mn
	local axes = {Vector3.xAxis, Vector3.yAxis, Vector3.zAxis}
	local comps = {ext.X, ext.Y, ext.Z}
	local fi = 1
	for i = 2, 3 do if comps[i] > comps[fi] then fi = i end end

	local fwd = axes[fi] * ((rawPos(cylSrc) - rawPos(hamSrc)):Dot(axes[fi]) >= 0 and 1 or -1)
	local d = rawPos(hamSrc) - rawPos(trgSrc)
	local ui, best = nil, -1
	for i = 1, 3 do
		if i ~= fi then
			local a = math.abs(d:Dot(axes[i]))
			if a > best then ui, best = i, a end
		end
	end
	local up = axes[ui] * (d:Dot(axes[ui]) >= 0 and 1 or -1)
	local right = up:Cross(-fwd)
	local R = CFrame.fromMatrix(Vector3.zero, right, up, -fwd):Inverse()

	local conv = {}
	for _, it in ipairs(raw) do conv[#conv + 1] = {cf = R * it.cf, size = it.size} end
	local cmn, cmx = aabbOf(conv)
	local cen = (cmn + cmx) / 2
	local len = math.max(cmx.Z - cmn.Z, 0.001)
	local S = (GC.length and GC.length > 0) and (GC.length / len) or GC.scale

	local f = GC.gripFrac
	local gpU = Vector3.new(cmn.X + f.X * (cmx.X - cmn.X), cmn.Y + f.Y * (cmx.Y - cmn.Y), cmn.Z + f.Z * len) - cen
	local cylc = (R * (inv * cylSrc.CFrame)).Position - cen
	return {
		R = R, cen = cen, S = S, lenS = len * S,
		gp = gpU * S + GC.gripNudge,
		muzzle = Vector3.new(cylc.X, cylc.Y, cmn.Z - cen.Z) * S,
	}
end

local function loadColt()
	if coltTemplate ~= nil then return coltTemplate end
	coltTemplate = false
	if not CONFIG.gun.useColt then return false end
	local getCustom = getcustomasset or getsynasset
	if not (writefile and isfile and getCustom) then
		warn("[RR] executor has no writefile/isfile/getcustomasset - using the built-in revolver")
		return false
	end
	local ok, res = pcall(function()
		local folder = CONFIG.gun.folder
		pcall(function() if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end end)
		local path = folder .. "/" .. CONFIG.gun.file
		if not isfile(path) then
			if #COLT_B64 < 1000 then error("no " .. path .. " in your workspace and no embedded model data") end
			writefile(path, b64dec(COLT_B64))
		end
		local objs = game:GetObjects(getCustom(path))
		local m = objs and objs[1]
		if not m then error("GetObjects returned nothing") end
		coltInfo = analyseColt(m)
		return m
	end)
	if ok and res and coltInfo then
		coltTemplate = res
		GUN_GRIP_INV = CFrame.new(-coltInfo.gp)
	else
		warn("[RR] could not load Colt.rbxm (" .. tostring(res) .. ") - using the built-in revolver")
	end
	return coltTemplate
end

local function makeColtModel(parent, name)
	local tpl = loadColt()
	if not tpl or not coltInfo then return end
	local okp, byName, frame, cylSrc, hamSrc, trgSrc = pcall(coltParts, tpl)
	if not okp then warn("[RR] Colt.rbxm is missing parts") return end
	local I = coltInfo
	local S, R, cen, lenS = I.S, I.R, I.cen, I.lenS

	local model = mk("Model", {Name = name or "RRRevolver"}, parent)
	local inv = frame.CFrame:Inverse()
	local function convCF(p)
		local X = R * (inv * p.CFrame)
		local v = X.Position
		return CFrame.new((v - cen) * S) * (X - v)
	end

	local root = mk("Part", {Name = "Frame", Size = Vector3.new(.1, .1, .1), Transparency = 1, CanCollide = false, CanTouch = false,
		CanQuery = false, Massless = true, CastShadow = false, CFrame = CFrame.new()}, model)

	local welds = {}
	for pname, src in pairs(byName) do
		local p = src:Clone()
		for _, c in ipairs(p:GetChildren()) do c:Destroy() end
		p.Size = src.Size * S
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = false, false, false, false
		p.Massless, p.CastShadow = true, false
		local c0 = convCF(src)
		p.CFrame = c0
		p.Parent = model
		welds[src] = mk("Weld", {Name = "W_" .. pname, Part0 = root, Part1 = p, C0 = c0}, p)
		if src == frame then p.Name = "Body"
		elseif src == cylSrc then p.Name = "Cylinder"
		elseif src == hamSrc then p.Name = "Hammer"
		elseif src == trgSrc then p.Name = "Trigger" end
	end
	local cylWeld, hammerWeld, triggerWeld = welds[cylSrc], welds[hamSrc], welds[trgSrc]
	local cyl = cylWeld.Part1

	local function invisible(n, size, cf, shape, color, mat)
		local p = mk("Part", {Name = n, Size = size, Color = color or Color3.new(1, 1, 1), Material = mat or Enum.Material.SmoothPlastic, Transparency = 1,
			CanCollide = false, CanTouch = false, CanQuery = false, Massless = true, CastShadow = false, CFrame = cf}, model)
		if shape then p.Shape = shape end
		mk("Weld", {Part0 = root, Part1 = p, C0 = cf}, p)
		return p
	end
